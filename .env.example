# Local Docker Compose
POSTGRES_USER=judging
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=judging
DATABASE_URL=postgresql://judging:change-this-database-password@db:5432/judging
JWT_SECRET=change-this-to-a-long-random-secret
ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=change-this-admin-password
COOKIE_SECURE=false
WEB_PORT=80

# Railway (set in the Railway dashboard or via `railway variables`)
# DATABASE_URL is injected automatically when you link a PostgreSQL service.
# PORT is injected automatically by Railway; do not set it manually.
# JWT_SECRET=generate-a-long-random-secret
# ADMIN_EMAIL=admin@your-domain.example
# ADMIN_PASSWORD=generate-a-strong-admin-password
# COOKIE_SECURE=true
# DATABASE_SSL=true
